<Window x:Class="DIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DIsland"
        Title="Lumen"
        Width="620" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Focusable="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <!-- Every view sits where the pill's top edge is; the pill's clip reveals it as the pill grows. -->
        <Style x:Key="IslandView" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <SolidColorBrush x:Key="Orange" Color="#FFFF9F0A" />
        <SolidColorBrush x:Key="Green" Color="#FF30D158" />
        <SolidColorBrush x:Key="Cyan" Color="#FF64D2FF" />
        <SolidColorBrush x:Key="Secondary" Color="#99FFFFFF" />
        <!-- Glass for the small bubbles beside the pill: translucent graphite with a lit top edge. -->
        <LinearGradientBrush x:Key="BubbleFill" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Color="#9C3A3A42" Offset="0" />
            <GradientStop Color="#9418181D" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BubbleRim" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#55FFFFFF" Offset="0" />
            <GradientStop Color="#18FFFFFF" Offset="0.5" />
            <GradientStop Color="#2AFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#FF2C2C2E" />

        <!-- Text boxes on the To-Do and Notes pages: no chrome, the field behind them draws it. -->
        <Style x:Key="IslandTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#FF64D2FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin, rounded, translucent scroll bar for pages that can outgrow the island. -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="2" Background="#55FFFFFF" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Width="4"
                                       Margin="0,2,-10,2" Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource SlimScrollThumb}" />
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root has no background: only the pill and its content are hit-testable, the rest clicks through. -->
    <!-- Fixed design size; the "Size" setting scales it with a LayoutTransform and resizes the window. -->
    <Grid x:Name="Root" Width="620" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top">
        <!-- Liquid Glass: a live, blurred copy of the screen behind the island, clipped to its shape. -->
        <Canvas x:Name="GlassLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Image x:Name="GlassImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear">
            </Image>
        </Canvas>

        <!-- Geometry is rebuilt every animation frame (rounded pill or notch with shoulders). -->
        <Path x:Name="PillShape" Fill="Black" />
        <!-- Liquid Glass: soft top highlight; brush is built in code from the Shininess setting. -->
        <Path x:Name="GlassSheen" IsHitTestVisible="False" Visibility="Collapsed" />
        <!-- Liquid Glass: soft light gathered just inside the rim (clipped to the pill in ApplyGeometry). -->
        <Path x:Name="GlassGlow" IsHitTestVisible="False" Visibility="Collapsed" StrokeThickness="14" />

        <Grid x:Name="ContentLayer">

            <!-- Clock (idle) -->
            <Grid x:Name="ClockView" Style="{StaticResource IslandView}" Width="150" Height="34">
                <StackPanel x:Name="ClockRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Analog style: a tiny clock face before the time. -->
                    <Grid x:Name="ClockFace" Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Stroke="#99FFFFFF" StrokeThickness="1.4" />
                        <Line X1="10" Y1="10" X2="10" Y2="5.8" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Line.RenderTransform><RotateTransform x:Name="ClockHourRot" CenterX="10" CenterY="10" /></Line.RenderTransform>
                        </Line>
                        <Line X1="10" Y1="10" X2="10" Y2="3.6" Stroke="#CCFFFFFF" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Line.RenderTransform><RotateTransform x:Name="ClockMinuteRot" CenterX="10" CenterY="10" /></Line.RenderTransform>
                        </Line>
                        <Ellipse Width="2.6" Height="2.6" Fill="White" />
                    </Grid>
                    <TextBlock x:Name="ClockText" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                    <!-- Optional weather: "| icon 26°" (UpdateClock). -->
                    <StackPanel x:Name="ClockWeather" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle Width="1.2" Height="14" Margin="11,0,11,0" VerticalAlignment="Center" RadiusX="0.6" RadiusY="0.6">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border x:Name="ClockWeatherIcon" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClockWeatherTemp" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Media (compact) -->
            <Grid x:Name="MediaView" Style="{StaticResource IslandView}" Width="340" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:WaveRibbon x:Name="MediaWave" Grid.ColumnSpan="4" Height="11" VerticalAlignment="Bottom" Visibility="Collapsed" />
                <!-- thin playback line along the bottom edge -->
                <Border x:Name="MediaLineSmall" Grid.ColumnSpan="4" Height="2" VerticalAlignment="Bottom"
                        Margin="18,0,18,3" CornerRadius="1" Background="#22FFFFFF" Visibility="Collapsed" ClipToBounds="True">
                    <Border CornerRadius="1" Background="#CCFFFFFF" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="MediaLineScale" ScaleX="0" /></Border.RenderTransform>
                    </Border>
                </Border>
                <Border x:Name="MediaArtSmall" Width="28" Height="28" Margin="8,0,0,0" CornerRadius="8"
                        BorderBrush="#2EFFFFFF" BorderThickness="1"
                        Background="{StaticResource ArtPlaceholder}">
                    <TextBlock x:Name="MediaArtSmallFallback" Style="{StaticResource Glyph}" Text="&#xE8D6;"
                               FontSize="11" Foreground="{StaticResource Secondary}" />
                </Border>
                <!-- Title (scrolls when it doesn't fit) over the artist; soft fade at both ends. -->
                <Grid x:Name="MediaTitleClip" Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="0.05" />
                            <GradientStop Color="#FF000000" Offset="0.93" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                    <StackPanel>
                        <TextBlock x:Name="MediaTitleSmall" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left"
                                   TextWrapping="NoWrap">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="MediaTitleShift" /></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="MediaArtistSmall" FontSize="10.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Secondary}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="MediaTimeSmall" Grid.Column="2" FontSize="11.5" Margin="6,0,12,2" VerticalAlignment="Center" TextAlignment="Right" LineHeight="13" LineStackingStrategy="BlockLineHeight"
                           Foreground="{StaticResource Secondary}" Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
            </Grid>

            <!-- Timer (compact) -->
            <Grid x:Name="TimerView" Style="{StaticResource IslandView}" Width="210" Height="36">
                <Grid Margin="16,0">
                    <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Left" Text="&#xE916;"
                               FontSize="15" Foreground="{StaticResource Orange}" />
                    <TextBlock x:Name="TimerTextSmall" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Orange}"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Grid>

            <!-- Stopwatch (compact) -->
            <Grid x:Name="StopwatchView" Style="{StaticResource IslandView}" Width="210" Height="36">
                <Grid Margin="16,0">
                    <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Left" Text="&#xE916;"
                               FontSize="15" Foreground="{StaticResource Cyan}" />
                    <TextBlock x:Name="StopwatchTextSmall" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Grid>

            <!-- Volume / brightness OSD -->
            <Grid x:Name="OsdView" Style="{StaticResource IslandView}" Width="320" Height="44">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OsdIcon" Style="{StaticResource Glyph}" HorizontalAlignment="Left"
                               FontSize="16" Text="&#xE767;" />
                    <Border Grid.Column="1" Height="6" Margin="8,0" CornerRadius="3" Background="#33FFFFFF"
                            VerticalAlignment="Center" ClipToBounds="True">
                        <Border x:Name="OsdFill" CornerRadius="3" Background="White" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock x:Name="OsdPercent" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Grid>

            <!-- Battery / charging -->
            <Grid x:Name="BatteryView" Style="{StaticResource IslandView}" Width="320" Height="44">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryBolt" Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="14"
                                   Margin="0,0,8,0" Foreground="{StaticResource Green}" />
                        <TextBlock x:Name="BatteryTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryPercent" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        <Grid Width="30" Height="14" VerticalAlignment="Center">
                            <Border Width="27" HorizontalAlignment="Left" BorderBrush="#80FFFFFF"
                                    BorderThickness="1.2" CornerRadius="4" />
                            <Border x:Name="BatteryFill" HorizontalAlignment="Left" Margin="2.5,2.5,0,2.5"
                                    Width="11" CornerRadius="2" Background="{StaticResource Green}" />
                            <Border HorizontalAlignment="Right" Width="2" Height="5" CornerRadius="0,1,1,0"
                                    Background="#80FFFFFF" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Short info alerts: device connected, Caps Lock, Do Not Disturb, copied / pasted.
                 Width is set per alert (ShowInfo). -->
            <Grid x:Name="InfoView" Style="{StaticResource IslandView}" Width="340" Height="44">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InfoGlyph" Style="{StaticResource Glyph}" Text="&#xE772;" FontSize="16" />
                    <TextBlock x:Name="InfoTitle" Grid.Column="1" Margin="10,0" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="InfoDetail" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                               MaxWidth="190" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>

            <!-- Another app's notification (icon, title, text, app). -->
            <Grid x:Name="NotificationView" Style="{StaticResource IslandView}" Width="370" Height="58">
                <Grid Margin="13,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="NotifIcon" Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                            Background="{StaticResource ArtPlaceholder}" />
                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NotifBody" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Secondary}" />
                    </StackPanel>
                    <TextBlock x:Name="NotifApp" Grid.Column="2" FontSize="11" MaxWidth="90" Margin="0,11,0,0"
                               VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Secondary}" />
                    <!-- Dismiss / snooze, shown while the cursor is over the alert. -->
                    <StackPanel x:Name="NotifActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border x:Name="NotifSnooze" Width="26" Height="26" CornerRadius="13" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" Cursor="Hand" ToolTip="Snooze"
                                MouseLeftButtonUp="OnNotifSnoozeClick" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="12" />
                        </Border>
                        <Border x:Name="NotifDismiss" Width="26" Height="26" CornerRadius="13" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" Cursor="Hand" ToolTip="Dismiss"
                                MouseLeftButtonUp="OnNotifDismissClick">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="11" />
                        </Border>
                    </StackPanel>
                    <!-- Verification code: a one-tap Copy button replaces the app name. -->
                    <Border x:Name="NotifCopy" Grid.Column="2" Visibility="Collapsed" CornerRadius="15" Padding="13,7"
                            VerticalAlignment="Center" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                            MouseLeftButtonUp="OnNotifCopyClick">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF3B9DFF" Offset="0" />
                                <GradientStop Color="#FF0A7AFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform><ScaleTransform x:Name="NotifCopyScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NotifCopyGlyph" Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock x:Name="NotifCopyText" Text="Copy" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Timer finished alert -->
            <Grid x:Name="TimerDoneView" Style="{StaticResource IslandView}" Width="320" Height="44">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerDoneGlyph" Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="15"
                               Margin="0,0,10,0" Foreground="{StaticResource Orange}" />
                    <TextBlock x:Name="TimerDoneText" Text="Timer finished" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="AlarmActions" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                        <Border CornerRadius="13" Padding="11,5" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonUp="OnAlarmSnoozeClick">
                            <TextBlock x:Name="AlarmSnoozeText" Text="Snooze" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <Border CornerRadius="13" Padding="11,5" Background="#FFFF453A" Cursor="Hand" MouseLeftButtonUp="OnAlarmStopClick">
                            <TextBlock Text="Stop" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Expanded -->
            <Grid x:Name="ExpandedView" Style="{StaticResource IslandView}" Width="420">
                <!-- Album art banner behind the media section, fading into the island. Brush set in code.
                     MotionBanner plays Apple Music motion artwork over it when available. -->
                <Border x:Name="ArtBanner" VerticalAlignment="Top" Height="160" Opacity="0.55"
                        Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#80000000" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <MediaElement x:Name="MotionBanner" Stretch="UniformToFill" IsMuted="True" Volume="0"
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False"
                                  Visibility="Collapsed" />
                </Border>
                <StackPanel x:Name="ExpandedContent" Margin="18,12,18,14">

                    <!-- Page navigation (tabs or dots, built in code); mic/camera chip on the right, left of the gear. -->
                    <Grid x:Name="PageNav" Height="22" Margin="0,0,34,10">
                        <!-- The selected tab's glass pill: one shape that glides between tabs (MoveTabLozenge). -->
                        <Border x:Name="TabLozenge" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14"
                                IsHitTestVisible="False" Visibility="Collapsed" BorderThickness="1"
                                Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassRim}" />
                        <StackPanel x:Name="PageTabs" Orientation="Horizontal" VerticalAlignment="Center" />
                        <StackPanel x:Name="PrivacyChip" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse x:Name="PrivacyChipDot" Width="7" Height="7" VerticalAlignment="Center" />
                            <TextBlock x:Name="PrivacyChipText" FontSize="11" Margin="6,0,0,0" MaxWidth="170"
                                       Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- One page visible at a time; switching slides between them (SwitchPage). -->
                    <Grid x:Name="PageHost" ClipToBounds="False">
                    <StackPanel x:Name="HomePage">

                    <Grid x:Name="MediaSection">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MediaArtLarge" Width="64" Height="64" CornerRadius="14"
                                    Background="{StaticResource ArtPlaceholder}">
                                <TextBlock x:Name="MediaArtLargeFallback" Style="{StaticResource Glyph}" Text="&#xE8D6;"
                                           FontSize="24" Foreground="{StaticResource Secondary}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,30,0" VerticalAlignment="Center">
                                <WrapPanel x:Name="MediaSources" Margin="0,0,0,4" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Ellipse x:Name="MediaAppDot" Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{StaticResource Green}" />
                                    <TextBlock x:Name="MediaAppName" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{StaticResource Secondary}" />
                                </StackPanel>
                                <TextBlock x:Name="MediaTitleLarge" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtistLarge" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaLyricLarge" FontSize="12.5" Margin="0,5,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource Green}" TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource Secondary}" Typography.NumeralAlignment="Tabular" />
                            <!-- Transparent background makes the whole 14px band clickable for seeking. -->
                            <Grid x:Name="ProgressHit" Grid.Column="1" Height="24" Background="Transparent"
                                  MouseLeftButtonUp="OnProgressMouseUp">
                                <local:MusicProgressBar x:Name="ProgressBar" />
                                <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"
                                        ClipToBounds="True" Visibility="Collapsed">
                                    <Border x:Name="ProgressFill" CornerRadius="2" Background="White"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="11" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{StaticResource Secondary}"
                                       Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Width="44" Height="40"
                                    Click="OnPreviousClick" ToolTip="Previous">
                                <!-- filled double-triangle rewind (iOS style) -->
                                <Path Fill="White" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      Data="M12,1.5 L1.5,10 L12,18.5 Z M22.5,1.5 L12,10 L22.5,18.5 Z" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="52" Height="44"
                                    Margin="14,0" Click="OnPlayPauseClick">
                                <Grid Width="24" Height="26">
                                    <TextBlock x:Name="PlayPauseGlyph" Visibility="Collapsed" />
                                    <Path x:Name="PlayShape" Fill="White" Stroke="White" StrokeThickness="2.4" StrokeLineJoin="Round"
                                          Data="M5,2.5 L21,13 L5,23.5 Z" Visibility="Collapsed" />
                                    <Path x:Name="PauseShape" Fill="White"
                                          Data="M3.5,1 H6.5 A2.5,2.5 0 0 1 9,3.5 V22.5 A2.5,2.5 0 0 1 6.5,25 H3.5 A2.5,2.5 0 0 1 1,22.5 V3.5 A2.5,2.5 0 0 1 3.5,1 Z M17.5,1 H20.5 A2.5,2.5 0 0 1 23,3.5 V22.5 A2.5,2.5 0 0 1 20.5,25 H17.5 A2.5,2.5 0 0 1 15,22.5 V3.5 A2.5,2.5 0 0 1 17.5,1 Z" />
                                </Grid>
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Width="44" Height="40"
                                    Click="OnNextClick" ToolTip="Next">
                                <Path Fill="White" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      Data="M1.5,1.5 L12,10 L1.5,18.5 Z M12,1.5 L22.5,10 L12,18.5 Z" />
                            </Button>
                        </StackPanel>
                        <!-- Lyrics button: only when synced lyrics were found for this song. -->
                        <Border x:Name="LyricsToggle" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,8,0,0" CornerRadius="15" Padding="11,6" Cursor="Hand" Visibility="Collapsed"
                                Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" MouseLeftButtonUp="OnLyricsToggleClick" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="LyricsToggleScale" /></Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Lyrics" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- The lyrics, opened under the controls; the island grows to fit. -->
                        <Border x:Name="LyricsInlineHost" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed"
                                CornerRadius="16" Background="#33000000" Padding="12,4" />
                    </Grid>

                    <StackPanel x:Name="ClockSection">
                        <local:GlassText x:Name="BigTime" FontSize="44" FontWeight="Light" HorizontalAlignment="Left" />
                        <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource Secondary}" />
                    </StackPanel>

                    <Border Height="1" Background="#22FFFFFF" Margin="0,14,0,12" />

                    <!-- Alarm is the main thing; Timer and Stopwatch sit on the side and swap the options below (MainWindow.Alarms.cs). -->
                    <Grid x:Name="ClockModeBar" Margin="0,0,0,8" />

                    <Grid x:Name="TimerPresets">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="14"
                                       Foreground="{StaticResource Orange}" />
                            <TextBlock Text="Timer" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="TimerPresetRow" Orientation="Horizontal" HorizontalAlignment="Left" Margin="-5,0,0,0">
                        </StackPanel>
                    </Grid>

                    <!-- Stopwatch, not started: a 3-second countdown button (built in code). -->
                    <Grid x:Name="StopwatchIdlePanel" Margin="0,2,0,0" Visibility="Collapsed" />

                    <!-- Running / paused stopwatch. -->
                    <Grid x:Name="StopwatchPanel" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="16"
                                       Foreground="{StaticResource Cyan}" />
                            <TextBlock x:Name="StopwatchTextLarge" FontSize="24" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource Cyan}"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Width="38" Height="34" Click="OnStopwatchPauseClick">
                                <TextBlock x:Name="StopwatchPauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="38" Height="34" Margin="2,0,0,0"
                                    Click="OnStopwatchResetClick" ToolTip="Reset stopwatch">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="TimerActivePanel">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="16"
                                       Foreground="{StaticResource Orange}" />
                            <TextBlock x:Name="TimerTextLarge" FontSize="24" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource Orange}"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ChipButton}" Content="+1m" Click="OnTimerAddClick" />
                            <Button Style="{StaticResource IconButton}" Width="38" Height="34" Margin="6,0,0,0"
                                    Click="OnTimerPauseClick">
                                <TextBlock x:Name="TimerPauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="38" Height="34" Margin="2,0,0,0"
                                    Click="OnTimerCancelClick" ToolTip="Cancel timer">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Alarms: set one here, see and remove the ones you have (built in code: MainWindow.Alarms.cs). -->
                    <StackPanel x:Name="AlarmRow" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Notifications from other apps; rows built in code (BuildNotificationList). -->
                    <StackPanel x:Name="NotificationsPage">
                        <Grid x:Name="NotificationsToolbar" Margin="0,0,0,6">
                            <TextBlock x:Name="NotificationsCount" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource Secondary}" />
                            <Button Style="{StaticResource ChipButton}" Content="Clear all" HorizontalAlignment="Right"
                                    Click="OnNotificationsClearClick" ToolTip="Clear all notifications (also from Windows' notification center)" />
                        </Grid>
                        <ScrollViewer x:Name="NotificationsScroller" Style="{StaticResource SlimScroll}" MaxHeight="252">
                            <StackPanel x:Name="NotificationList" />
                        </ScrollViewer>
                        <TextBlock x:Name="NotificationsEmpty" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,6"
                                   HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource Secondary}" />
                        <Button x:Name="NotificationsSetup" Style="{StaticResource ChipButton}" Content="Set up…"
                                HorizontalAlignment="Center" Margin="0,2,0,4" Click="OnIdentitySetupClick" />
                    </StackPanel>

                    <!-- Calendar: the next week from iCal links and the Windows calendar (BuildCalendar). -->
                    <StackPanel x:Name="CalendarPage">
                        <!-- Month grid: today highlighted, dots on days with events; click a day to list it. -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock x:Name="CalendarMonthTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Width="28" Height="24" Click="OnCalendarPrevMonth" ToolTip="Previous month">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="28" Height="24" Click="OnCalendarNextMonth" ToolTip="Next month">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <UniformGrid x:Name="CalendarWeekdays" Columns="7" />
                        <UniformGrid x:Name="CalendarDays" Columns="7" />
                        <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,8" />
                        <ScrollViewer x:Name="CalendarScroller" Style="{StaticResource SlimScroll}" MaxHeight="150">
                            <StackPanel x:Name="CalendarList" />
                        </ScrollViewer>
                        <TextBlock x:Name="CalendarEmpty" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,6"
                                   HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource Secondary}" />
                    </StackPanel>

                    <!-- To-Do: add with Enter; rows are built in code (BuildTodoList). Clicks here never
                         collapse the island (they'd lose what's being typed). -->
                    <StackPanel x:Name="TodoPage" Background="Transparent" MouseLeftButtonUp="OnTypingPageMouseUp">
                        <Border CornerRadius="12" Background="#1AFFFFFF" Height="36" Cursor="IBeam"
                                MouseLeftButtonDown="OnTodoFieldMouseDown">
                            <Grid Margin="12,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12"
                                           HorizontalAlignment="Left" Foreground="{StaticResource Secondary}" />
                                <TextBlock x:Name="TodoPlaceholder" Text="Add a task" FontSize="13" Margin="24,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{StaticResource Secondary}" />
                                <TextBox x:Name="TodoInput" Style="{StaticResource IslandTextBox}" Margin="24,0,0,0"
                                         VerticalAlignment="Center" MaxLength="300"
                                         PreviewMouseLeftButtonDown="OnTypingBoxMouseDown"
                                         PreviewKeyDown="OnTodoInputKeyDown" TextChanged="OnTodoInputChanged" />
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="TodoScroller" Style="{StaticResource SlimScroll}" MaxHeight="200" Margin="0,8,0,0">
                            <StackPanel x:Name="TodoList" />
                        </ScrollViewer>
                        <StackPanel x:Name="TodoEmpty" Margin="0,14,0,10">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="20"
                                       Foreground="{StaticResource Green}" />
                            <TextBlock Text="All done" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Type a task above and press Enter" FontSize="11" Margin="0,2,0,0"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Secondary}" />
                        </StackPanel>
                        <Grid x:Name="TodoFooter" Margin="0,6,0,0">
                            <TextBlock x:Name="TodoCount" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource Secondary}" />
                            <Button x:Name="TodoClearDone" Style="{StaticResource ChipButton}" Content="Clear completed"
                                    HorizontalAlignment="Right" Click="OnTodoClearDoneClick" />
                        </Grid>
                    </StackPanel>

                    <!-- Notes: one scratch pad, saved as you type (NotesService). -->
                    <StackPanel x:Name="NotesPage" Background="Transparent" MouseLeftButtonUp="OnTypingPageMouseUp">
                        <Border CornerRadius="14" Background="#14FFFFFF" Padding="12,10" Height="168" Cursor="IBeam"
                                MouseLeftButtonDown="OnNoteFieldMouseDown">
                            <Grid>
                                <TextBlock x:Name="NotePlaceholder" Text="Jot something down…" FontSize="13"
                                           IsHitTestVisible="False" Foreground="{StaticResource Secondary}" />
                                <TextBox x:Name="NoteBox" Style="{StaticResource IslandTextBox}" AcceptsReturn="True"
                                         AcceptsTab="True" TextWrapping="Wrap" MaxLength="20000"
                                         PreviewMouseLeftButtonDown="OnTypingBoxMouseDown"
                                         PreviewKeyDown="OnNoteKeyDown" TextChanged="OnNoteChanged" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Name="NoteStatus" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource Secondary}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ChipButton}" Content="Copy" Click="OnNoteCopyClick"
                                        ToolTip="Copy the note to the clipboard" />
                                <Button x:Name="NoteClearButton" Style="{StaticResource ChipButton}" Content="Clear"
                                        Click="OnNoteClearClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- AI assistant: the panel is built in code (AssistantPanel). -->
                    <Grid x:Name="AssistantPage" Background="Transparent" MouseLeftButtonUp="OnTypingPageMouseUp" />
                    <!-- Clipboard history: the panel is built in code (ClipboardPanel). -->
                    <Grid x:Name="ClipboardPage" Background="Transparent" MouseLeftButtonUp="OnTypingPageMouseUp" />
                    <!-- Focus sessions: the panel is built in code (FocusPanel). -->
                    <Grid x:Name="FocusPage" Background="Transparent" MouseLeftButtonUp="OnTypingPageMouseUp" />
                    <!-- Lyrics: the panel is built in code (LyricsPanel). -->
                    <Grid x:Name="LyricsPage" Background="Transparent" MouseLeftButtonUp="OnTypingPageMouseUp" />
                    <!-- System vitals: the panel is built in code (VitalsPanel). -->
                    <Grid x:Name="VitalsPage" Background="Transparent" />

                    <!-- File shelf: files dropped on the island; tiles are built in code (BuildShelf).
                         Drag a tile (or "Drag all") out to drop the files anywhere. -->
                    <Grid x:Name="ShelfPage">
                        <StackPanel>
                            <Grid x:Name="ShelfToolbar" Margin="0,0,0,8">
                                <TextBlock x:Name="ShelfCount" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource Secondary}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ShelfDragAll" Style="{StaticResource ChipButton}" Content="Drag all"
                                            ToolTip="Drag every file on the shelf somewhere" />
                                    <Button Style="{StaticResource ChipButton}" Content="Clear" Click="OnShelfClearClick"
                                            ToolTip="Remove everything from the shelf (the files themselves stay where they are)" />
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="ShelfScroller" Style="{StaticResource SlimScroll}" MaxHeight="196">
                                <WrapPanel x:Name="ShelfItems" />
                            </ScrollViewer>
                            <Grid x:Name="ShelfEmpty" Height="104">
                                <Rectangle RadiusX="14" RadiusY="14" Stroke="#55FFFFFF" StrokeThickness="1.5"
                                           StrokeDashArray="4 3" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="20"
                                               Foreground="{StaticResource Secondary}" />
                                    <TextBlock Text="Drop files here" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Drag files onto the island to keep them handy" FontSize="11"
                                               Margin="0,2,0,0" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Secondary}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <!-- Shown while files are dragged over the island. -->
                        <Grid x:Name="ShelfDropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle x:Name="ShelfDropRect" RadiusX="14" RadiusY="14" StrokeThickness="2"
                                       StrokeDashArray="4 3" Fill="#B0000000" Stroke="White" />
                            <TextBlock x:Name="ShelfDropText" Text="Drop to add to the shelf" FontSize="13"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- Weather: now, the next 12 hours, 5 days. Icons and rows are built in code (UpdateWeather). -->
                    <StackPanel x:Name="WeatherPage">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="WeatherNowIcon" Width="50" Height="50" VerticalAlignment="Center" />
                            <TextBlock x:Name="WeatherNowTemp" Grid.Column="1" FontSize="40" FontWeight="Light"
                                       Margin="10,0,14,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="WeatherCondition" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="WeatherDetail" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="WeatherPlaceText" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <UniformGrid x:Name="WeatherHours" Rows="1" Margin="0,14,0,0" />
                        <Border Height="1" Background="#22FFFFFF" Margin="0,12,0,8" />
                        <StackPanel x:Name="WeatherDays" />
                        <TextBlock x:Name="WeatherProblemText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource Secondary}" Visibility="Collapsed" />
                        <!-- Required attribution: Open-Meteo data is licensed CC BY 4.0; place names from
                             OpenStreetMap (ODbL) when "My location" is used (UpdateWeather). -->
                        <TextBlock x:Name="WeatherAttribution" Text="Weather data by Open-Meteo.com" FontSize="10" Margin="0,6,0,0"
                                   HorizontalAlignment="Right" Foreground="{StaticResource Secondary}" Opacity="0.7" />
                    </StackPanel>

                    <!-- Quick-launch apps; tiles are built in code from the QuickApps setting. -->
                    <ScrollViewer x:Name="AppsPage" Style="{StaticResource SlimScroll}" MaxHeight="232">
                        <WrapPanel x:Name="QuickAppsRow" HorizontalAlignment="Center" Margin="0,6,0,6" />
                    </ScrollViewer>

                    <StackPanel x:Name="WallpaperPage">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- Shows the wallpaper's (often animated) preview; brush is only attached while expanded. -->
                                <Border x:Name="WallpaperThumb" Width="48" Height="48" CornerRadius="10"
                                        Background="{StaticResource ArtPlaceholder}">
                                    <TextBlock x:Name="WallpaperThumbFallback" Style="{StaticResource Glyph}"
                                               Text="&#xE8B9;" FontSize="16" Foreground="{StaticResource Secondary}" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="WALLPAPER" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource Secondary}" />
                                    <TextBlock x:Name="WallpaperTitle" Text="Wallpaper Engine" FontSize="13"
                                               FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Width="38" Height="30"
                                        Click="OnWallpaperPauseClick" ToolTip="Pause / resume wallpaper">
                                    <TextBlock x:Name="WallpaperPauseGlyph" Style="{StaticResource Glyph}"
                                               Text="&#xE769;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="38" Height="30" Margin="2,0,0,0"
                                        Click="OnWallpaperMuteClick" ToolTip="Mute / unmute wallpaper">
                                    <TextBlock x:Name="WallpaperMuteGlyph" Style="{StaticResource Glyph}"
                                               Text="&#xE767;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="38" Height="30" Margin="2,0,0,0"
                                        Click="OnWallpaperNextClick" ToolTip="Next wallpaper (playlist)">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    </Grid>

                </StackPanel>

                <Button Style="{StaticResource ChipButton}" Width="30" Height="30" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0"
                        Click="OnSettingsClick" ToolTip="Settings (or right-click the island)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14"
                               Foreground="{StaticResource Secondary}" />
                </Button>
            </Grid>

        </Grid>

        <!-- Second activity (e.g. music while a timer runs), as a small bubble beside the pill like the
             iPhone's split island. Content set in UpdateSecondActivity; positioned in ApplyGeometry. -->
        <Grid x:Name="ActivityBubble" HorizontalAlignment="Left" VerticalAlignment="Top" Width="36" Height="36"
              Visibility="Collapsed" RenderTransformOrigin="0,0.5" Cursor="Hand">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Ellipse x:Name="ActivityBubbleBack" Fill="{StaticResource BubbleFill}" Stroke="{StaticResource BubbleRim}" StrokeThickness="1" />
            <Ellipse x:Name="ActivityBubbleArt" Margin="5" Visibility="Collapsed" />
            <TextBlock x:Name="ActivityBubbleGlyph" Style="{StaticResource Glyph}" FontSize="15" Text="&#xE916;" />
            <Path x:Name="ActivityBubbleRing" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  IsHitTestVisible="False" />
        </Grid>

        <!-- Idle weather: its own round bubble beside the clock pill (UpdateIdleWeatherBubble). -->
        <Grid x:Name="IdleWeatherBubble" HorizontalAlignment="Left" VerticalAlignment="Top" Width="34" Height="34"
              Visibility="Collapsed" RenderTransformOrigin="0,0.5" Cursor="Hand">
            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
            <Ellipse Fill="{StaticResource BubbleFill}" Stroke="{StaticResource BubbleRim}" StrokeThickness="1" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="IdleWeatherIcon" Width="16" Height="16" HorizontalAlignment="Center" />
                <TextBlock x:Name="IdleWeatherTemp" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-1,0,0" />
            </StackPanel>
        </Grid>

        <!-- Music split: the album art as a spinning disc with a progress ring, left of the title pill. -->
        <Grid x:Name="MediaDiscBubble" HorizontalAlignment="Left" VerticalAlignment="Top" Width="36" Height="36"
              Visibility="Collapsed" RenderTransformOrigin="1,0.5" Cursor="Hand">
            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
            <Ellipse Fill="{StaticResource BubbleFill}" Stroke="{StaticResource BubbleRim}" StrokeThickness="1" />
            <Ellipse x:Name="MediaDiscArt" Margin="4.5" RenderTransformOrigin="0.5,0.5" Fill="#33FFFFFF">
                <Ellipse.RenderTransform><RotateTransform x:Name="MediaDiscSpin" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="6" Height="6" Fill="#E6101014" Stroke="#66FFFFFF" StrokeThickness="0.8" />
            <Path x:Name="MediaDiscRing" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
            <Border x:Name="MediaSourceBadge" Width="14" Height="14" CornerRadius="7" Background="#FF2DD4FF" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed">
                <TextBlock x:Name="MediaSourceBadgeText" FontSize="9" FontWeight="Bold" Foreground="#FF06222B" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Music split: the equalizer as a small pulse bubble right of the title pill. -->
        <Grid x:Name="MediaPulseBubble" HorizontalAlignment="Left" VerticalAlignment="Top" Width="36" Height="36"
              Visibility="Collapsed" RenderTransformOrigin="0,0.5" Cursor="Hand">
            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
            <Ellipse Fill="{StaticResource BubbleFill}" Stroke="{StaticResource BubbleRim}" StrokeThickness="1" />
                <Ellipse x:Name="AuraGlow" Margin="3" Opacity="0.35" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="AuraScale" ScaleX="0.85" ScaleY="0.85" /></Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="AuraStopA" Color="#FF9FB4FF" Offset="0" />
                            <GradientStop x:Name="AuraStopB" Color="#009FB4FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel x:Name="Equalizer" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <Rectangle Width="3.2" Height="22" RadiusX="1.6" RadiusY="1.6" Margin="1.3,0" Fill="{StaticResource Green}" />
                    <Rectangle Width="3.2" Height="22" RadiusX="1.6" RadiusY="1.6" Margin="1.3,0" Fill="{StaticResource Green}" />
                    <Rectangle Width="3.2" Height="22" RadiusX="1.6" RadiusY="1.6" Margin="1.3,0" Fill="{StaticResource Green}" />
                    <Rectangle Width="3.2" Height="22" RadiusX="1.6" RadiusY="1.6" Margin="1.3,0" Fill="{StaticResource Green}" />
                    <Rectangle Width="3.2" Height="22" RadiusX="1.6" RadiusY="1.6" Margin="1.3,0" Fill="{StaticResource Green}" />
                </StackPanel>
        </Grid>

        <!-- Carry: a notification or a copy waits as a small bubble for a few seconds. -->
        <Grid x:Name="CarryBubble" HorizontalAlignment="Left" VerticalAlignment="Top" Width="36" Height="36"
              Visibility="Collapsed" RenderTransformOrigin="0,0.5" Cursor="Hand" MouseLeftButtonUp="OnCarryClick">
            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
            <Ellipse Fill="{StaticResource BubbleFill}" Stroke="{StaticResource BubbleRim}" StrokeThickness="1" />
            <Ellipse x:Name="CarryIcon" Margin="5" Visibility="Collapsed" />
            <TextBlock x:Name="CarryGlyph" Style="{StaticResource Glyph}" FontSize="15" Text="&#xE77F;" />
            <Border x:Name="CarryBadge" Width="15" Height="15" CornerRadius="8" Background="#FFFF453A" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed">
                <TextBlock x:Name="CarryBadgeText" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Quick tray: hover the collapsed pill to get music controls and what you just copied. -->
        <Border x:Name="QuickTray" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" CornerRadius="24"
                Padding="8,7" BorderBrush="{StaticResource BubbleRim}" BorderThickness="1"
                RenderTransformOrigin="0.5,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                    <GradientStop Color="#E0303036" Offset="0" />
                    <GradientStop Color="#E018181D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
            <StackPanel x:Name="TrayRow" Orientation="Horizontal" />
        </Border>

        <!-- Pinned timer: stays beside the island (even when it is open) until you unpin it. -->
        <Grid x:Name="PinnedTimerBubble" HorizontalAlignment="Left" VerticalAlignment="Top" Width="40" Height="40"
              Visibility="Collapsed" RenderTransformOrigin="1,0.5" Cursor="Hand">
            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
            <Ellipse Fill="{StaticResource BubbleFill}" Stroke="{StaticResource BubbleRim}" StrokeThickness="1" />
            <Path x:Name="PinnedTimerRing" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
            <TextBlock x:Name="PinnedTimerText" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" />
        </Grid>

        <!-- Third activity: a second bubble after the first. -->
        <Grid x:Name="ActivityBubble2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="36" Height="36"
              Visibility="Collapsed" RenderTransformOrigin="0,0.5" Cursor="Hand">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Ellipse Fill="{StaticResource BubbleFill}" Stroke="{StaticResource BubbleRim}" StrokeThickness="1" />
            <Ellipse x:Name="ActivityBubbleArt2" Margin="5" Visibility="Collapsed" />
            <TextBlock x:Name="ActivityBubbleGlyph2" Style="{StaticResource Glyph}" FontSize="15" Text="&#xE916;" />
            <Path x:Name="ActivityBubbleRing2" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  IsHitTestVisible="False" />
        </Grid>

        <!-- Mic (orange) / camera (green) in use, just right of the collapsed pill like the iPhone's
             privacy dot. Outside ContentLayer's clip; positioned in ApplyGeometry. -->
        <Ellipse x:Name="PrivacyDot" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                 IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Window>
