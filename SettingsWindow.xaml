<Window x:Class="DIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumen Settings"
        Width="700" Height="780" MinHeight="400" MinWidth="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF141416" Foreground="White" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FF0A84FF" />

        <!-- Toggle switch: every CheckBox becomes a label with an animated switch on the right. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11"
                                    Background="#33FFFFFF" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left"
                                         Margin="2,0,0,0">
                                    <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" /></Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented pills: radio groups read as chips, the chosen one filled with the accent. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Margin" Value="0,3,6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="15" Padding="14,5" Background="{StaticResource GlassFill}"
                                BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#66FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Soft fields only in Settings — never leak into Clara / the island. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource SoftField}" />
    </Window.Resources>

    <DockPanel>
        <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Background="#99121214" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <StackPanel x:Name="CreditRow" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OnWebserClick">
                    <Border x:Name="WebserMarkHost" Width="18" Height="18" Margin="0,0,8,0" Background="Transparent" />
                    <TextBlock x:Name="CreditText" VerticalAlignment="Center" FontSize="12" Foreground="#80FFFFFF" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChipButton}" Content="Reset to defaults" Click="OnResetClick" />
                    <Button Style="{StaticResource ChipButton}" Content="Close" Margin="8,0,0,0" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Section index: jumps to a section; the current one is highlighted while scrolling. -->
        <Border x:Name="NavBar" DockPanel.Dock="Left" Width="176" Background="#8C121214" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0">
            <ScrollViewer x:Name="NavScroller" Style="{StaticResource SlimScroll}">
                <StackPanel x:Name="Nav" Margin="10,14,10,14" />
            </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="SettingsScroller" Style="{StaticResource SlimScroll}">
            <!-- Sections are generated in code-behind. -->
            <StackPanel x:Name="Sections" Margin="24,4,24,20" />
        </ScrollViewer>
    </DockPanel>
</Window>
