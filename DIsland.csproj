<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DIsland</AssemblyName>
    <RootNamespace>DIsland</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Lumen.ico</ApplicationIcon>
    <Product>Lumen</Product>
    <Version>1.3.1</Version>
    <Description>Lumen, a personal island for Windows</Description>
    <Authors>vibhoram</Authors>
    <Company>vibhoram</Company>
    <Copyright>Copyright (c) 2026 vibhoram. Lumen is a modified version under the D-Island License 1.0.</Copyright>
    <PackageProjectUrl>https://github.com/vibhoram/Lumen</PackageProjectUrl>
    <!-- WinForms' DPI analyzer; WPF owns DPI here and reads it from app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <!-- Always-running overlay: favour a small, quiet footprint. No background GC thread (the heap is
         tiny) and English-only satellite resources. Tiered PGO is OFF: measured, it re-JITs for about
         0.6 s of CPU after every launch (instrumented tier, then tier-1) and made animation no faster
         (35.4% vs 30.9% of a core, optimised build, 3 runs each). The app's time goes to rendering. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- WPF and WinForms both define Application, MessageBox, Brush, etc.; only the tray file opts into WinForms/Drawing. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

  <!-- Sparse package (identity for notifications + Windows calendar): the manifest and the script
       that packs, signs and registers it, next to the exe. See Identity\setup-identity.ps1. -->
  <ItemGroup>
    <None Include="Identity\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Clara's portrait (and any other drop-in assets) next to the exe. -->
  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Compiled pixel shader for the Liquid Glass refraction (source: Shaders\LiquidGlass.fx). -->
  <ItemGroup>
    <Resource Include="Shaders\LiquidGlass.ps" />
    <EmbeddedResource Include="Shaders\LensVS.cso" LogicalName="LensVS.cso" />
    <EmbeddedResource Include="Shaders\LensPS.cso" LogicalName="LensPS.cso" />
    <None Include="Shaders\*.hlsl" />
    <None Include="Shaders\LiquidGlass.fx" />
  </ItemGroup>

  <!-- Licence, privacy statement and third-party notices travel with every build (Settings > About links them). -->
  <ItemGroup>
    <None Include="LICENSE.txt;NOTICE.txt;PRIVACY.txt;THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Repository files that aren't part of the app. -->
    <None Remove=".github\**" />
    <Compile Remove=".github\**" />
  </ItemGroup>

</Project>
